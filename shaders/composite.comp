#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_GOOGLE_include_directive : enable

#include <vulkano.glsl>
#include "common/contract.glsl"
#include "common/exposure.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    StorageImageId image_id;
    StorageImageId color_id;
    StorageBufferId exposure_buffer_id;
    uint mode;
    uint width;
    uint height;
};

VKO_DECLARE_STORAGE_BUFFER(exposure, Exposure{
    uint bins[EXPOSURE_BINS];
    uint ev;
    uint sky_count;
    uint prev_sky;
})

#define exposure_state vko_buffer(exposure, exposure_buffer_id)

vec3 aces_fit(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    bool oob = uint(p.x) >= width || uint(p.y) >= height;

    if (mode != MODE_VOXEL) {
        return;
    }

    vec3 radiance = vec3(0.0);

    if (!oob) {
        radiance = imageLoad(vko_image2D_rgba16f(color_id), p).rgb;
    }

    if (!oob) {
        float lum = clamp(dot(radiance, vec3(0.2126, 0.7152, 0.0722)), 0.0, EXPOSURE_LUM_CLAMP);
        uint bin = clamp(uint((log2(max(lum, exp2(EXPOSURE_BIN_LOG2_MIN)))- EXPOSURE_BIN_LOG2_MIN) / EXPOSURE_BIN_STEPS), 0u, uint(EXPOSURE_BINS - 1));

        atomicAdd(exposure_state.bins[bin], 1u);
    }

    if (oob) {
        return;
    }

    vec3 color = aces_fit(radiance * exp2(uintBitsToFloat(exposure_state.ev)));
    color = pow(color, vec3(1.0 / 2.2));

    // Interleaved gradient noise (Jimenez 2014): one display LSB of static
    // per-pixel dither against the 8-bit store's gradient banding.
    float dither = fract(52.9829189 * fract(0.06711056 * float(p.x)
        + 0.00583715 * float(p.y)));
    color += (dither - 0.5) / 255.0;
    imageStore(vko_image2D_rgba8(image_id), p, vec4(color, 1.0));
}
