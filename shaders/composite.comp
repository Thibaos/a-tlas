#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_GOOGLE_include_directive : enable

#include <vulkano.glsl>
#include "common/nrd.glsl"
#include "common/contract.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    StorageImageId image_id;
    StorageImageId radiance_id;
    StorageImageId spec_radiance_id;
    StorageImageId diff_denoised_id;
    StorageImageId spec_denoised_id;
    StorageImageId viewz_id;
    StorageImageId albedo_metal_id;
    StorageImageId validation_id;
    float ev;
    uint mode;
    uint denoiser;
    uint width;
    uint height;
};

vec3 aces_fit(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (uint(p.x) >= width || uint(p.y) >= height) {
        return;
    }

    if (mode == MODE_VALIDATION) {
        vec4 overlay = imageLoad(vko_image2D_rgba8(validation_id), p);
        imageStore(vko_image2D_rgba8(image_id), p, vec4(overlay.rgb, 1.0));
        return;
    }

    if (mode != MODE_VOXEL) {
        return;
    }


    vec4 diff_raw = imageLoad(vko_image2D_rgba16f(radiance_id), p);
    vec3 albedo = imageLoad(vko_image2D_rgba8(albedo_metal_id), p).rgb;

    float viewz = imageLoad(vko_image2D_r32f(viewz_id), p).x;
    bool is_sky = viewz >= VIEWZ_SKY;

    vec3 radiance;
    if (denoiser == 0u) {
        vec3 diff_de = nrd_unpack_radiance(diff_raw);
        vec3 spec = nrd_unpack_radiance(imageLoad(vko_image2D_rgba16f(spec_radiance_id), p));
        radiance = is_sky ? diff_de : diff_de * max(albedo, vec3(ALBEDO_EPS)) + spec;
    } else {
        vec3 diffuse = nrd_unpack_radiance(imageLoad(vko_image2D_rgba16f(diff_denoised_id), p));
        vec3 specular = nrd_unpack_radiance(imageLoad(vko_image2D_rgba16f(spec_denoised_id), p));
        radiance = is_sky
            ? nrd_unpack_radiance(diff_raw) : diffuse * max(albedo, vec3(ALBEDO_EPS)) + specular;
    }

    vec3 color = aces_fit(radiance * exp2(ev));
    color = pow(color, vec3(1.0 / 2.2));
    imageStore(vko_image2D_rgba8(image_id), p, vec4(color, 1.0));
}
