#version 460

#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_GOOGLE_include_directive : enable
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "../common/header.glsl"
#include "../common/bindings.glsl"

struct HullAabb {
    vec3 min;
    vec3 max;
};

layout(buffer_reference, scalar) readonly buffer HullAabbBuffer {
    HullAabb aabbs[];
};

uint voxel_index(ivec3 cell_in_microchunk) {
    return uint(cell_in_microchunk.x) + VOXEL_STRIDE_Y * uint(cell_in_microchunk.y)
        + VOXEL_STRIDE_Z * uint(cell_in_microchunk.z);
}

uint microchunk_index(ivec3 mc) {
    return MC_STRIDE_Z * uint(mc.z) + MC_STRIDE_Y * uint(mc.y) + uint(mc.x);
}

uint material_rank(RegionPool pool, uint block_offset, uint idx) {
    uint word = idx >> 5u;
    uint bit = idx & 31u;
    uint base = block_offset >> 2u;
    uint count = 0u;
    for (uint w = 0u; w < word; ++w) {
        count += bitCount(pool.words[base + w]);
    }
    count += bitCount(pool.words[base + word] & ((1u << bit) - 1u));
    return count;
}

bool aabb_slab(vec3 origin, vec3 dir, float tmin, float tmax, vec3 bmin, vec3 bmax, out float t0, out float t1) {
    t0 = tmin;
    t1 = tmax;
    for (int a = 0; a < 3; ++a) {
        float d = dir[a];
        if (d == 0.0) {
            if (origin[a] < bmin[a] || origin[a] >= bmax[a]) {
                return false;
            }
        } else {
            float inv = 1.0 / d;
            float a0 = (bmin[a] - origin[a]) * inv;
            float a1 = (bmax[a] - origin[a]) * inv;
            if (a0 > a1) {
                float tmp = a0;
                a0 = a1;
                a1 = tmp;
            }
            t0 = max(t0, a0);
            t1 = min(t1, a1);
            if (t0 > t1) {
                return false;
            }
        }
    }
    return t1 > t0;
}

void main() {
    vec3 origin = gl_ObjectRayOriginEXT;
    vec3 dir = gl_ObjectRayDirectionEXT;
    float tmin = gl_RayTminEXT;
    float tmax = gl_RayTmaxEXT;

    if (tmax <= tmin) {
        return;
    }

    uint region_id = gl_InstanceCustomIndexEXT & REGION_ID_MASK;
    uint64_t pool_bda = region_table.bdas[region_id];

    if (pool_bda == 0ul) {
        return;
    }

    RegionPool pool = RegionPool(pool_bda);
    uint64_t aabb_bda = aabb_table.bdas[region_id];

    if (aabb_bda == 0ul) {
        return;
    }

    HullAabbBuffer aabbs = HullAabbBuffer(aabb_bda);
    HullAabb b = aabbs.aabbs[gl_PrimitiveID];

    float t0;
    float t1;

    if (!aabb_slab(origin, dir, tmin, tmax, b.min, b.max, t0, t1)) {
        return;
    }

    ivec3 mc = ivec3(b.min) >> 3;
    uint block_offset = pool.words[microchunk_index(mc)];
    vec3 entry = origin + dir * t0;
    ivec3 cell = ivec3(floor(entry));

    ivec3 step = ivec3(0);
    vec3 t_next = vec3(0.0);
    vec3 delta = vec3(0.0);
    for (int a = 0; a < 3; ++a) {
        float d = dir[a];
        if (d == 0.0) {
            step[a] = 1;
            t_next[a] = FLT_MAX;
            delta[a] = FLT_MAX;
        } else if (d > 0.0) {
            step[a] = 1;
            float boundary = float(cell[a] + 1);
            t_next[a] = (boundary - origin[a]) / d;
            delta[a] = 1.0 / d;
        } else {
            step[a] = -1;
            float boundary = float(cell[a]);
            t_next[a] = (boundary - origin[a]) / d;
            delta[a] = -1.0 / d;
        }
    }

    float t_entry = t0;
    int last_axis = -1;
    ivec3 chunk_origin = mc << 3;

    while (true) {
        ivec3 c = cell - chunk_origin;

        if (!any(lessThan(c, ivec3(0))) && !any(greaterThanEqual(c, ivec3(8)))) {
            if (block_offset != OFFSET_SENTINEL) {
                uint idx = voxel_index(c);
                uint base = block_offset >> 2u;
                uint word = idx >> 5u;
                uint bit = idx & 31u;
                uint mask_word = pool.words[base + word];
                uint bit_mask = 1u << bit;

                if ((mask_word & bit_mask) != 0u) {
                    uint count = material_rank(pool, block_offset, idx);
                    uint byte_off = block_offset + MASK_BYTES + count;
                    uint byte_word = pool.words[byte_off >> 2u];
                    uint material = (byte_word >> ((byte_off & 3u) << 3u)) & 0xFFu;
                    // Snap the reported crossing to the division form of the
                    // entered boundary: the accumulated t_entry carries one
                    // rounding per march step, and closest-hit reconstructs
                    // the entered face from p = o + d*t — drift past a few
                    // ULP would fall off the boundary into the no-face
                    // fallback. One division here keeps the reported hit on
                    // the face.
                    float t_report = t_entry;
                    if (last_axis >= 0) {
                        float boundary = (step[last_axis] > 0)
                            ? float(cell[last_axis])
                            : float(cell[last_axis] + 1);
                        t_report = max(
                            (boundary - origin[last_axis]) / dir[last_axis],
                            tmin
                        );
                    }
                    reportIntersectionEXT(t_report, material);
                    return;
                }
            }
        }

        int axis;
        if (t_next.x <= t_next.y && t_next.x <= t_next.z) {
            axis = 0;
        } else if (t_next.y <= t_next.z) {
            axis = 1;
        } else {
            axis = 2;
        }
        float next_t = t_next[axis];
        if (next_t >= t1) {
            return;
        }
        cell[axis] += step[axis];
        t_next[axis] = next_t + delta[axis];
        t_entry = next_t;
        last_axis = axis;
    }
}
