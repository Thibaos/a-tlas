#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable

#include "../rt/common.glsl"
#include "../rt/deps.glsl"
#include "../rt/raygen_common.glsl"

layout(location = 0) rayPayloadEXT MainPassPayload payload;

// Validation raygen. Identical to shaders/rt/simple.rgen (the ray is
// built by the shared raygen_common.glsl, the trace is the same call), except
// it additionally writes the committed hit distance payload.t to `t_image_id`
// as rgba32f so the validator can compare per-pixel {color, t} against the CPU
// reference tracer. The color store is byte-identical to the production
// raygen, so the captured color frame IS the raw renderer output.
void main() {
    vec3 origin;
    vec3 direction;
    build_primary_ray(origin, direction);

    const uint ray_flags = gl_RayFlagsOpaqueEXT;

    payload.color = vec4(0.0);
    payload.t = -1.0;

    traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), ray_flags, 0xFFu, 0u, 0u, 0u, origin, EPSILON, direction, FLT_MAX, 0);

    imageStore(vko_image2D_rgba8(image_id), ivec2(gl_LaunchIDEXT.xy), payload.color);
    imageStore(vko_image2D_rgba32f(t_image_id), ivec2(gl_LaunchIDEXT.xy), vec4(payload.t, 0.0, 0.0, 1.0));
}
