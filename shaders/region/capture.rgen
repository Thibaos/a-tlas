#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require

#include "../common/common.glsl"
#include "header.glsl"
#include "common.glsl"
#include "../common/raygen_common.glsl"

layout(location = 0) rayPayloadEXT MainPassPayload payload;

// Validation raygen for the Region path. The ray
// is built by the shared raygen_common.glsl (byte-identical to the
// production raygen), traverses world-space f32 with Opaque over the camera
// near/far range, and writes the primary-visibility result
// directly to the swapchain storage image plus the committed hit distance
// to `t_image_id` as rgba32f, so the validator can compare per-pixel
// {color, t} against the CPU reference tracer.
//
// Deliberately NOT TerminateOnFirstHit (see production.rgen): the flag
// terminates at the first hit found in traversal order, which is not the
// closest in general — the DDA commits the nearest occupied cell within one
// Region, but the hardware never compares across Regions before
// terminating. The reference tracer is closest-hit; the flags must match.
void main() {
    vec3 origin;
    vec3 direction;
    build_primary_ray(origin, direction);

    const uint ray_flags = gl_RayFlagsOpaqueEXT;

    payload.color = vec4(0.0);
    payload.t = -1.0;
    payload.hit_kind = 0u;
    payload.normal = vec3(0.0);

    // Voxel-only: the shader-binding-table record offset is hardcoded 0
    // (the DDA hit group) — the validator never toggles to Hull.
    traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), ray_flags, 0xFFu, 0u, 0u, 0u, origin, RAY_T_MIN, direction, RAY_T_MAX, 0);

    imageStore(vko_image2D_rgba8(image_id), ivec2(gl_LaunchIDEXT.xy), payload.color);
    imageStore(vko_image2D_rgba32f(t_image_id), ivec2(gl_LaunchIDEXT.xy), vec4(payload.t, 0.0, 0.0, 1.0));
}
