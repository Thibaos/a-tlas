#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require

#include <vulkano.glsl>
#include "../common/contract.glsl"

layout(push_constant) uniform ResolvePushConstants {
    StorageBufferId cache_state_buffer_id;
};

#include "cache.glsl"

// SHaRC's Resolve, one thread per table entry: the edit-frame dirty sweep
// and the stale-aging eviction clear entries away, a touched entry blends
// its frame's deposits into the stored state under 02's ladder, and the
// accumulator resets for the next frame. Untouched entries keep their
// record — coverage is age-bounded by CACHE_EVICT_T, not by the sweep.
void main() {
    uint entry = gl_GlobalInvocationID.x;

    if (entry >= CACHE_TABLE_ENTRIES) {
        return;
    }

    CacheKeys keys = CacheKeys(cache_state.keys_bda);
    uint64_t key = keys.keys[entry];

    if (key == 0ul) {
        return;
    }

    uint region_id = uint(key) & REGION_ID_MASK;
    CacheAccum accum = CacheAccum(cache_state.accum_bda);
    CacheResolved resolved = CacheResolved(cache_state.resolved_bda);

    if ((CacheDirty(cache_state.dirty_bda).words[region_id >> 5]
            & (1u << (region_id & 31u))) != 0u) {
        keys.keys[entry] = 0ul;
        accum.ticks[entry] = uvec4(0u);
        resolved.recs[entry] = uvec4(0u);

        return;
    }

    uvec4 ticks = accum.ticks[entry];
    uvec4 rec = resolved.recs[entry];
    uint count = ticks.w;

    if (count == 0u) {
        if (rec.z != 0u && cache_state.frame_index - rec.z >= CACHE_EVICT_T) {
            keys.keys[entry] = 0ul;
            resolved.recs[entry] = uvec4(0u);
        }

        return;
    }

    vec3 mean = vec3(ticks.xyz) / (float(count) * CACHE_ACC_SCALE);
    vec2 rg = unpackHalf2x16(rec.x);
    vec2 bz = unpackHalf2x16(rec.y);
    vec3 old = pow(vec3(rg.x, rg.y, bz.x), vec3(CACHE_IRRADIANCE_GAMMA));

    // 02's ladder on the aggregate: a big move replaces, a moderate one
    // sags the old weight, and a single-frame brightening impulse is
    // clamped (absent entries skip the clamp so cold start fills).
    float old_lum = (old.r + old.g + old.b) / 3.0;
    float mean_lum = (mean.r + mean.g + mean.b) / 3.0;
    float weight = cache_old_weight(CACHE_BASE_HYSTERESIS);
    float change = abs(mean_lum - old_lum) / max(old_lum, 1e-6);

    if (change > CACHE_LADDER_HIGH) {
        weight = 0.0;
    } else if (change > CACHE_LADDER_LOW) {
        weight = max(weight - CACHE_LADDER_STEP, 0.0);
    }

    if (old_lum > 0.0 && mean_lum > old_lum * CACHE_IMPULSE) {
        mean *= old_lum * CACHE_IMPULSE / mean_lum;
    }

    cache_store(entry, mix(mean, old, weight));
    cache_note_touched(region_id);

    accum.ticks[entry] = uvec4(0u);
}
