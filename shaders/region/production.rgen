#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require

#include "../common/common.glsl"
#include "header.glsl"
#include "common.glsl"
#include "../common/raygen_common.glsl"
#include "../common/radiance.glsl"
#include "cache.glsl"
#include "sky.glsl"

layout(location = 0) rayPayloadEXT MainPassPayload payload;

const uint MAX_BOUNCES = 2u;
const float LOBE_P = 0.5;

const float SUN_PICK_P = 0.5;
const float SKY_PICK_P = 1.0 - SUN_PICK_P;
const float RR_FLOOR = 0.05; // Russian-roulette survival floor (bounded variance)
const float BOUNCE_OFFSET = 1e-3; // bounce origin nudged along the normal (self-intersection)
const float ALPHA_MIN = 1e-4; // GGX alpha floor (perfect-mirror singularity guard)
const float COS_EPS = 1e-6; // cos-term guard in the G1/pdf denominators (grazing NaN guard)
const uint MAX_CROSSINGS = 32u; // hard cap of glass voxel crossings per path (ADR 0013; past it the hit shades opaque)
const uint MAX_PANES = 32u; // hard cap of Panes per shadow segment (ADR 0014; past it shadow visibility is 0)
const float CROSS_EPS = 1e-3; // glass advance nudged past the exit boundary, in t (ADR 0016)
const float CROSS_RESTATE_T = 1e-4; // restated hit distance for origin-inside commits (keeps the offset origins on the crossed-boundary side)
const uint WALK_GUARD = 512u; // bounds glass voxels walked per segment (loop safety; far above any real pane)

const float PI = 3.14159265358979;
const float TWO_PI = 6.28318530717959;

// Stateless path RNG (PCG-XSH-RR, O'Neill 2014): every draw is a pure
// function of (seed, draw_index), no mutable per-path state.
uint pcg_hash(uint x) {
    uint state = x * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    word = (word >> 22u) ^ word;
    return word;
}

// One uniform draw in [0, 1) from the (seed, index) pair.
float rand_unit(uint seed, uint index) {
    uint h = pcg_hash(seed ^ (index * 0x9E3779B1u));
    return float(h >> 8u) * (1.0 / 16777216.0);
}

// Deterministic local tangent frame from the geometric normal: reference
// (0,1,0), falling back to (1,0,0) when the normal is (anti-)parallel to y.
void make_frame(vec3 n, out vec3 t_axis, out vec3 b_axis) {
    vec3 ref = (abs(n.y) > 0.999) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    t_axis = normalize(cross(ref, n));
    b_axis = cross(n, t_axis);
}

// Cosine-weighted diffuse sample in the frame (n, t_axis, b_axis); u1, u2 in
// [0,1). Returns the direction and its pdf (cosθ/π). The Lambertian bounce
// weight is (1-metallic)·albedo (f·cosθ/pdf cancels to albedo).
vec3 sample_cosine(vec3 n, vec3 t_axis, vec3 b_axis, float u1, float u2, out float pdf) {
    float r = sqrt(u1);
    float phi = TWO_PI * u2;
    float cz = sqrt(max(0.0, 1.0 - u1));
    vec3 dir = t_axis * (r * cos(phi)) + b_axis * (r * sin(phi)) + n * cz;
    pdf = cz * (1.0 / PI);
    return dir;
}

float ggx_d(float n_dot_h, float alpha) {
    float a2 = alpha * alpha;
    float denom = n_dot_h * n_dot_h * (a2 - 1.0) + 1.0;
    return a2 / (PI * denom * denom);
}

float smith_g1(float n_dot_v, float alpha) {
    float a2 = alpha * alpha;
    float nv = max(n_dot_v, COS_EPS);
    return 2.0 * nv / (nv + sqrt(a2 + (1.0 - a2) * nv * nv));
}

vec3 fresnel_schlick(vec3 f0, float cos_theta) {
    return f0 + (1.0 - f0) * pow(clamp(1.0 - cos_theta, 0.0, 1.0), 5.0);
}

float vndf_pdf(vec3 l_local, vec3 v_local, vec3 h, float alpha) {
    float n_dot_h = max(h.z, 0.0);
    float v_dot_h = max(dot(v_local, h), 0.0);
    float n_dot_v = max(v_local.z, COS_EPS);
    return (ggx_d(n_dot_h, alpha) * smith_g1(n_dot_v, alpha) * v_dot_h / n_dot_v)
        / (4.0 * max(v_dot_h, COS_EPS));
}

vec3 sample_vndf(vec3 v_local, float alpha, float u1, float u2, out vec3 h, out float pdf) {
    vec3 Vh = normalize(vec3(alpha * v_local.x, alpha * v_local.y, v_local.z));
    float len_sq = dot(Vh.xy, Vh.xy);
    vec3 T1 = (len_sq > 0.0) ? vec3(-Vh.y, Vh.x, 0.0) * inversesqrt(len_sq) : vec3(1.0, 0.0, 0.0);
    vec3 T2 = cross(Vh, T1);
    float r = sqrt(u1);
    float phi = TWO_PI * u2;
    float t1 = r * cos(phi);
    float t2 = r * sin(phi);
    float s = 0.5 * (1.0 + Vh.z);
    t2 = (1.0 - s) * sqrt(max(0.0, 1.0 - t1 * t1)) + s * t2;
    vec3 Nh = t1 * T1 + t2 * T2 + sqrt(max(0.0, 1.0 - t1 * t1 - t2 * t2)) * Vh;
    h = normalize(vec3(alpha * Nh.x, alpha * Nh.y, max(0.0, Nh.z)));
    vec3 l = reflect(-v_local, h);
    pdf = vndf_pdf(l, v_local, h, alpha);
    return l;
}

vec3 specular_weight(vec3 l_local, vec3 v_local, vec3 h, vec3 f0, float alpha, float pdf) {
    float n_dot_l = max(l_local.z, 0.0);
    float n_dot_v = max(v_local.z, COS_EPS);
    float n_dot_h = max(h.z, 0.0);
    float v_dot_h = max(dot(v_local, h), 0.0);
    float d = ggx_d(n_dot_h, alpha);
    float g2 = smith_g1(n_dot_v, alpha) * smith_g1(n_dot_l, alpha);
    vec3 f = fresnel_schlick(f0, v_dot_h);
    return f * d * g2 / (4.0 * n_dot_v * max(pdf, COS_EPS));
}

vec3 specular_nl(vec3 l_local, vec3 v_local, vec3 h, vec3 f0, float alpha) {
    float n_dot_l = max(l_local.z, 0.0);
    float n_dot_v = max(v_local.z, COS_EPS);
    float n_dot_h = max(h.z, 0.0);
    float v_dot_h = max(dot(v_local, h), 0.0);
    float d = ggx_d(n_dot_h, alpha);
    float g2 = smith_g1(n_dot_v, alpha) * smith_g1(n_dot_l, alpha);
    vec3 f = fresnel_schlick(f0, v_dot_h);
    return f * d * g2 / (4.0 * n_dot_v);
}

vec3 brdf_nl(vec3 l_local, vec3 v_local, vec3 f0, float alpha, vec3 albedo, float metallic) {
    vec3 h = normalize(v_local + l_local);
    return (1.0 - metallic) * albedo * (max(l_local.z, 0.0) / PI)
        + specular_nl(l_local, v_local, h, f0, alpha);
}

float bsdf_mixture_pdf(vec3 l_local, vec3 v_local, float alpha, int depth) {
    vec3 h = normalize(v_local + l_local);
    float p_v = vndf_pdf(l_local, v_local, h, alpha);
    float p_c = max(l_local.z, 0.0) * (1.0 / PI);
    if (depth == 0) {
        return LOBE_P * p_v + (1.0 - LOBE_P) * p_c;
    }
    return 0.5 * (p_v + p_c);
}

float sky_light_pdf(vec3 dir) {
    return SKY_PICK_P * sky_mu_pdf(dir.y) * (1.0 / TWO_PI);
}

void reset_payload() {
    payload.color = vec4(0.0);
    payload.t = -1.0;
    payload.hit_kind = 0u;
    payload.normal = vec3(0.0);
    payload.cache_key = 0u;
    payload.cache_meta = 0u;
}

// The committed cell of a glass hit: faced hits sit on the division-form
// entered boundary (the same snap closest-hit reconstructs the face from);
// origin-inside commits (mid-pane re-entry, interior origin) are already
// inside the cell.
ivec3 glass_cell(vec3 p, uint cache_meta, vec3 n) {
    ivec3 cell = ivec3(floor(p));

    if ((cache_meta & CACHE_META_FACED) != 0u) {
        for (int a = 0; a < 3; ++a) {
            if (n[a] != 0.0) {
                float eps = 32.0 * 1.1920929e-07 * max(abs(p[a]), 1.0);
                cell[a] = int(floor(p[a] + eps)) - ((n[a] < 0.0) ? 0 : 1);
                break;
            }
        }
    }

    return cell;
}

// Amanatides-Woo exit of the crossed cell from the entry point p: the
// argmin axis is the crossed boundary, the successor cell the open pane's
// expected successor.
void glass_exit(vec3 p, vec3 d, ivec3 cell, out float t_exit, out ivec3 successor) {
    vec3 t_exit_per_axis = vec3(0.0);

    for (int a = 0; a < 3; ++a) {
        t_exit_per_axis[a] = (d[a] == 0.0) ? 1e30
            : (((d[a] > 0.0) ? float(cell[a] + 1) : float(cell[a])) - p[a]) / d[a];
    }

    t_exit = min(t_exit_per_axis.x, min(t_exit_per_axis.y, t_exit_per_axis.z));
    successor = cell;

    if (t_exit == t_exit_per_axis.x) {
        successor.x += (d.x > 0.0) ? 1 : -1;
    } else if (t_exit == t_exit_per_axis.y) {
        successor.y += (d.y > 0.0) ? 1 : -1;
    } else {
        successor.z += (d.z > 0.0) ? 1 : -1;
    }
}

// Straight-transmission walk (ADR 0013/0016): resolves committed glass
// hits before shading. A Pane is a maximal same-index run of contiguous
// glass voxels along the ray; its Palette tint is paid once at entry, the
// origin advances past each crossed cell (p + d·(t_exit + ε)), and the
// ray re-traces in the same direction. Pane detection is raygen-local
// successor comparison — exact across Micro-chunk and Region boundaries.
// A Crossing is one pass through a glass voxel — the unit the cap
// counts. Crossings consume no Bounces and draw no random numbers; past
// MAX_CROSSINGS the current glass voxel stays committed and shades
// opaque (fail-dark). Emission on a glass voxel rides the panes its own
// segment closed before it (un-attenuated by its own Pane; earlier
// segments' panes ride the entry throughput).
struct GlassWalk {
    uint crossings;
    bool pane_open;
    uint pane_index;
    ivec3 pane_next;
    vec3 emission;
    float advance;
};

void walk_glass(inout vec3 ro, vec3 rd, uint ray_flags, uint sbt_offset,
        inout vec3 throughput, inout GlassWalk gw) {
    vec3 closed_here = vec3(1.0);
    bool opened_here = false;
    gw.advance = 0.0;

    for (uint guard = 0u; guard < WALK_GUARD; ++guard) {
        if (payload.t <= 0.0) {
            return;
        }

        if ((material_table.flags[payload.hit_kind] & MATFLAG_GLASS) == 0u) {
            return;
        }

        if (gw.crossings >= MAX_CROSSINGS) {
            return;
        }

        uint idx = payload.hit_kind;
        vec3 p = ro + rd * payload.t;
        ivec3 cell = glass_cell(p, payload.cache_meta, payload.normal);

        bool mid_pane = gw.pane_open && (cell == gw.pane_next) && (idx == gw.pane_index);
        if (!mid_pane) {
            if (gw.pane_open && opened_here) {
                closed_here *= palette.colors[gw.pane_index].rgb;
            }
            gw.pane_index = idx;
            gw.pane_open = true;
            opened_here = true;
            throughput *= palette.colors[idx].rgb;
        }

        gw.crossings++;
        gw.emission += closed_here * material_table.rough_emit[idx].rgb;

        float t_exit;
        ivec3 successor;
        glass_exit(p, rd, cell, t_exit, successor);
        gw.pane_next = successor;

        ro = p + rd * (t_exit + CROSS_EPS);
        gw.advance += t_exit + CROSS_EPS;

        reset_payload();
        traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), ray_flags, 0xFFu, sbt_offset, 0u, 0u, ro, RAY_T_MIN, rd, RAY_T_MAX, 0);

        // A no-face commit right after the advance is the origin-inside
        // case: the ray is already past the crossed boundary, so the true
        // entered face is the one just crossed. Restate the hit there —
        // axis-aligned normal against the ray, origin rewound to the
        // boundary, hit distance a hair past it — so the BOUNCE_OFFSET
        // origins clear the voxel instead of re-committing it from inside.
        if (payload.t > 0.0 && (payload.cache_meta & CACHE_META_FACED) == 0u) {
            int crossed_axis = (successor.x != cell.x) ? 0 : ((successor.y != cell.y) ? 1 : 2);
            payload.normal = vec3(0.0);
            payload.normal[crossed_axis] = (rd[crossed_axis] > 0.0) ? -1.0 : 1.0;
            ro = p + rd * t_exit;
            payload.t = CROSS_RESTATE_T;
            gw.advance -= CROSS_EPS;
        }
    }
}

// Shadow-segment visibility (ADR 0014): the transport walk's pane law,
// scored as transmittance. Crossed Panes multiply their Palette tint once
// at entry — the origin run (a shading face opening into glass) pays at
// its first observed crossing — an opaque hit reports 0, a miss the pane
// product, and past MAX_PANES the segment fails dark. No random draws;
// the trace stays Opaque-flagged and MIS is untouched.
vec3 shadow_transmittance(vec3 hit_point, vec3 normal, vec3 light_dir,
        uint ray_flags, uint sbt_offset) {
    vec3 origin = hit_point + normal * BOUNCE_OFFSET;
    vec3 visibility = vec3(1.0);

    bool pane_open = false;
    uint pane_index = 0u;
    ivec3 pane_next = ivec3(0);
    uint panes = 0u;

    reset_payload();
    traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), ray_flags, 0xFFu, sbt_offset, 0u, 0u, origin, RAY_T_MIN, light_dir, RAY_T_MAX, 0);

    for (uint guard = 0u; guard < WALK_GUARD; ++guard) {
        if (payload.t <= 0.0) {
            return visibility;
        }

        if ((material_table.flags[payload.hit_kind] & MATFLAG_GLASS) == 0u) {
            return vec3(0.0);
        }

        uint idx = payload.hit_kind;
        vec3 p = origin + light_dir * payload.t;
        ivec3 cell = glass_cell(p, payload.cache_meta, payload.normal);

        if (!(pane_open && (cell == pane_next) && (idx == pane_index))) {
            if (panes >= MAX_PANES) {
                return vec3(0.0);
            }

            pane_open = true;
            pane_index = idx;
            visibility *= palette.colors[idx].rgb;
            panes++;
        }

        float t_exit;
        ivec3 successor;
        glass_exit(p, light_dir, cell, t_exit, successor);
        pane_next = successor;

        origin = p + light_dir * (t_exit + CROSS_EPS);

        reset_payload();
        traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), ray_flags, 0xFFu, sbt_offset, 0u, 0u, origin, RAY_T_MIN, light_dir, RAY_T_MAX, 0);
    }

    return vec3(0.0);
}

void main() {
    vec3 origin;
    vec3 direction;
    build_primary_ray(origin, direction);

    const uint ray_flags = gl_RayFlagsOpaqueEXT;

    reset_payload();

    uint sbt_offset = (mode == MODE_HULL) ? 1u : 0u;

    traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), ray_flags, 0xFFu, sbt_offset, 0u, 0u, origin, RAY_T_MIN, direction, RAY_T_MAX, 0);

    if (mode == MODE_VOXEL || mode == MODE_VALIDATION) {
        ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
        float hit_t = payload.t;
        vec3 primary_albedo = vec3(0.0);
        float primary_metallic = 0.0;
        float primary_roughness = 1.0;
        vec3 primary_emission = vec3(0.0);
        vec3 primary_normal = vec3(0.0);

        uint seed = pcg_hash((frame_seed * 0x9E3779B1u)
                    ^ (uint(gl_LaunchIDEXT.y) * gl_LaunchSizeEXT.x + uint(gl_LaunchIDEXT.x)));
        uint draw = 0u;

        vec3 radiance = vec3(0.0);
        vec3 specular = vec3(0.0);
        vec3 path = vec3(0.0);
        vec3 throughput = vec3(1.0);
        bool specular_lobe = false;

        // A refresh continuation at a covered face exists to feed deposits;
        // its radiance is already paid for by the cache read.
        bool feed_only = false;

        // Hit distance of the first in-lobe segment after the primary hit
        // (NRD's noisy-input contract); -1 until observed, meaning "no ray".
        float bounce_t = -1.0;

        // Deposit chains (02's accumulate half): each traced continuation
        // opens one at its origin's face, seeded with the cos/pdf of the
        // sampled direction; every later hit adds the chain weight times
        // that hit's unweighted local shading to the face's accumulator.
        uvec2 chain_key[2] = uvec2[2](uvec2(0u), uvec2(0u));
        vec3 chain_tp[2] = vec3[2](vec3(0.0), vec3(0.0));
        uint chain_flags[2] = uint[2](0u, 0u);
        // Primary glass walk (ADR 0016): resolve panes before shading.
        GlassWalk gw = GlassWalk(0u, false, 0u, ivec3(0), vec3(0.0), 0.0);
        vec3 ro = origin;
        vec3 rd = direction;
        bool glass_primary = false; // primary surface revealed behind glass
        bool cap_fail = false;      // past MAX_CROSSINGS: current voxel shades opaque
        bool crossed_miss = false;  // path crossed only glass, then missed

        if (hit_t > 0.0) {
            walk_glass(ro, rd, ray_flags, sbt_offset, throughput, gw);
            if (!feed_only) {
                path += gw.emission;
            }

            if (payload.t <= 0.0) {
                crossed_miss = true;
                hit_t = -1.0;
            } else if ((material_table.flags[payload.hit_kind] & MATFLAG_GLASS) != 0u) {
                cap_fail = true;
            } else if (gw.crossings > 0u) {
                glass_primary = true;
            }
        }

        // The G-buffer surface is the committed hit (ADR 0015): B at a glass
        // primary, the cap-fail voxel past the cap; the crossings' segment
        // lengths fold into the accumulated primary t.
        if (hit_t > 0.0) {
            if (glass_primary || cap_fail) {
                hit_t = dot(ro + rd * payload.t - origin, direction);
            }

            vec4 albedo_metallic = material_table.albedo_metallic[payload.hit_kind];
            vec4 rough_emit = material_table.rough_emit[payload.hit_kind];
            primary_albedo = albedo_metallic.rgb;
            primary_metallic = albedo_metallic.a;
            primary_roughness = rough_emit.a;
            primary_emission = rough_emit.rgb;
            primary_normal = normalize(payload.normal);
        }

        if (hit_t > 0.0) {
            if (!glass_primary && !cap_fail) {
                radiance += primary_emission;
            }

            if (!glass_primary) {
                specular_lobe = rand_unit(seed, draw++) < LOBE_P;
            }
            float lobe_p = specular_lobe ? LOBE_P : (1.0 - LOBE_P);

            vec3 albedo = primary_albedo;
            float metallic = primary_metallic;
            float roughness = primary_roughness;
            vec3 normal = primary_normal;
            float next_p_bsdf = 0.0;
            vec3 hit_emission = vec3(0.0);

            if (glass_primary || cap_fail) {
                hit_emission = primary_emission;

                if (!feed_only) {
                    path += throughput * primary_emission;
                }
            }

            for (int depth = 0; depth <= int(MAX_BOUNCES); ++depth) {

                bool primary_lobe = depth == 0 && !glass_primary;

                if (depth > 0) {
                    // Resolve glass panes crossed by this segment (no RNG,
                    // no depth); a walk-miss falls into the miss branch
                    // below with the pane-tinted throughput.
                    vec3 em_before = gw.emission;
                    vec3 tp_before = throughput;
                    walk_glass(ro, rd, ray_flags, sbt_offset, throughput, gw);
                    if (!feed_only) {
                        path += tp_before * (gw.emission - em_before);
                    }

                    if (payload.t <= 0.0) {
                        float p_light = sky_light_pdf(rd);
                        vec3 sky_est = payload.color.rgb
                                * (next_p_bsdf / (p_light + next_p_bsdf));

                        for (uint c = 0u; c < 2u; ++c) {
                            if ((chain_flags[c] & 1u) == 0u) {
                                continue;
                            }

                            cache_deposit(chain_key[c].x & REGION_ID_MASK,
                                    chain_key[c].x >> 12, (chain_key[c].y & 511u),
                                    (chain_key[c].y >> 9) & 7u, (chain_flags[c] & 2u) == 0u,
                                    chain_tp[c] * sky_est);
                            chain_flags[c] |= 2u;
                        }

                        if (!feed_only) {
                            path += throughput * sky_est;
                        }

                        break;
                    }
                    if (depth == 1 && bounce_t < 0.0 && !feed_only) {
                        bounce_t = payload.t + gw.advance;
                    }

                    vec4 albedo_metallic = material_table.albedo_metallic[payload.hit_kind];
                    vec4 rough_emit = material_table.rough_emit[payload.hit_kind];
                    albedo = albedo_metallic.rgb;
                    metallic = albedo_metallic.a;
                    roughness = rough_emit.a;
                    hit_emission = rough_emit.rgb;

                    if (!feed_only) {
                        path += throughput * rough_emit.rgb;
                    }
                }

                vec3 hit_point = ro + rd * payload.t;

                // The hit's cache key, packed by closest_hit (the faced bit
                // clears for no-face hits, misses, and hull/debug payloads).
                uint hit_key = payload.cache_key;
                uint hit_meta = payload.cache_meta;
                uint hit_region = hit_key & REGION_ID_MASK;
                uint hit_block = hit_key >> 12;
                uint hit_slot = hit_meta & 511u;
                uint hit_face = (hit_meta >> 9) & 7u;
                bool hit_faced = (hit_meta & CACHE_META_FACED) != 0u;

                vec3 nee_rad = vec3(0.0);
                if (rand_unit(seed, draw++) < SUN_PICK_P) {
                    vec3 sun_dir = scene.sun_dir.xyz;
                    float n_dot_l = max(dot(normal, sun_dir), 0.0);
                    vec3 vis = (n_dot_l > 0.0)
                        ? shadow_transmittance(hit_point, normal, sun_dir, ray_flags, sbt_offset)
                        : vec3(0.0);
                    if (any(greaterThan(vis, vec3(0.0)))) {
                        vec3 t_axis;
                        vec3 b_axis;
                        make_frame(normal, t_axis, b_axis);
                        vec3 v_local = -vec3(dot(rd, t_axis), dot(rd, b_axis), dot(rd, normal));
                        float alpha = max(roughness * roughness, ALPHA_MIN);
                        vec3 f0 = mix(vec3(0.04), albedo, metallic);
                        vec3 l_local = vec3(dot(sun_dir, t_axis), dot(sun_dir, b_axis), n_dot_l);
                        vec3 f_nl = primary_lobe
                            ? (specular_lobe
                            ? specular_nl(l_local, v_local, normalize(v_local + l_local), f0, alpha) : (1.0 - metallic) * albedo * (n_dot_l / PI)) : brdf_nl(l_local, v_local, f0, alpha, albedo, metallic);
                        nee_rad = f_nl * scene.sun_disk.x * (1.0 / SUN_PICK_P) * vis;
                    }
                } else {
                    float u1 = rand_unit(seed, draw++);
                    float u2 = rand_unit(seed, draw++);
                    float phi = TWO_PI * u1;
                    float mu = sky_sample_mu(u2);
                    float r = sqrt(max(0.0, 1.0 - mu * mu));
                    vec3 light_dir = vec3(r * cos(phi), mu, r * sin(phi));
                    float n_dot_l = max(dot(normal, light_dir), 0.0);
                    vec3 vis = (n_dot_l > 0.0)
                        ? shadow_transmittance(hit_point, normal, light_dir, ray_flags, sbt_offset)
                        : vec3(0.0);
                    if (any(greaterThan(vis, vec3(0.0)))) {
                        float p_light = sky_light_pdf(light_dir);
                        vec3 t_axis;
                        vec3 b_axis;
                        make_frame(normal, t_axis, b_axis);
                        vec3 v_local = -vec3(dot(rd, t_axis), dot(rd, b_axis), dot(rd, normal));
                        float alpha = max(roughness * roughness, ALPHA_MIN);
                        vec3 f0 = mix(vec3(0.04), albedo, metallic);
                        vec3 l_local = vec3(dot(light_dir, t_axis), dot(light_dir, b_axis), n_dot_l);
                        float p_bsdf = bsdf_mixture_pdf(l_local, v_local, alpha, primary_lobe ? 0 : 1);
                        float w = p_light / (p_light + p_bsdf);
                        vec3 f_nl = primary_lobe
                            ? (specular_lobe
                            ? specular_nl(l_local, v_local, normalize(v_local + l_local), f0, alpha) : (1.0 - metallic) * albedo * (n_dot_l / PI)) : brdf_nl(l_local, v_local, f0, alpha, albedo, metallic);
                        nee_rad = f_nl * sky_radiance(light_dir) * w / p_light * vis;
                    }
                }
                if (!feed_only) {
                    path += throughput * nee_rad;
                }

                // ADR 0019's read: the diffuse lobe's indirect from the
                // previous frame's resolved entry, albedo/π-modulated at the
                // hit (the direct term's demodulation stays untouched). An
                // uncovered or immature hit renders the traced BSDF estimate
                // below — a young entry's mean is the claim-time pop's
                // shape — and the trace feeds the face's accumulator either
                // way.
                vec3 cached = vec3(0.0);
                bool immature = false;
                bool covered = hit_faced
                    && cache_fetch(hit_region, hit_block, hit_slot, hit_face, cached, immature);

                if (covered && !immature && (depth > 0 || !specular_lobe) && !feed_only) {
                    path += throughput * ((1.0 - metallic) * albedo * (1.0 / PI) * cached);
                }

                // Deposits: every open chain samples this hit's unweighted
                // local estimate (emission + NEE).
                vec3 local_est = nee_rad + hit_emission;

                for (uint c = 0u; c < 2u; ++c) {
                    if ((chain_flags[c] & 1u) == 0u) {
                        continue;
                    }

                    cache_deposit(chain_key[c].x & REGION_ID_MASK, chain_key[c].x >> 12,
                            (chain_key[c].y & 511u), (chain_key[c].y >> 9) & 7u,
                            (chain_flags[c] & 2u) == 0u, chain_tp[c] * local_est);
                    chain_flags[c] |= 2u;
                }

                if (depth == int(MAX_BOUNCES)) {
                    break;
                }

                vec3 t_axis;
                vec3 b_axis;
                make_frame(normal, t_axis, b_axis);
                vec3 v_local = -vec3(dot(rd, t_axis), dot(rd, b_axis), dot(rd, normal));
                float alpha = max(roughness * roughness, ALPHA_MIN);
                vec3 f0 = mix(vec3(0.04), albedo, metallic);
                vec3 wi;
                vec3 weight;
                float chain_p;
                bool trace_ray = true;
                uint born = 2u;

                if (primary_lobe) {
                    if (specular_lobe) {
                        vec3 h;
                        float pdf;
                        vec3 l_local = sample_vndf(v_local, alpha, rand_unit(seed, draw++),
                                rand_unit(seed, draw++), h, pdf);
                        wi = t_axis * l_local.x + b_axis * l_local.y + normal * l_local.z;
                        weight = specular_weight(l_local, v_local, h, f0, alpha, pdf);
                        chain_p = max(dot(normal, wi), 0.0) / (LOBE_P * max(pdf, COS_EPS));
                        born = 0u;
                    } else if (covered && !immature) {
                        if (rand_unit(seed, draw++) < CACHE_REFRESH_P) {
                            float pdf;
                            wi = sample_cosine(normal, t_axis, b_axis, rand_unit(seed, draw++),
                                    rand_unit(seed, draw++), pdf);
                            weight = (1.0 - metallic) * albedo;
                            chain_p = PI / (1.0 - LOBE_P);
                            born = 0u;
                            feed_only = true;
                        } else {
                            trace_ray = false;
                        }
                    } else {
                        float pdf;
                        wi = sample_cosine(normal, t_axis, b_axis, rand_unit(seed, draw++),
                                rand_unit(seed, draw++), pdf);
                        weight = (1.0 - metallic) * albedo;
                        chain_p = PI / (1.0 - LOBE_P);
                        born = 0u;
                    }
                } else {
                    bool spec_pick = rand_unit(seed, draw++) < 0.5;

                    if (spec_pick) {
                        vec3 h;
                        float pdf;
                        vec3 l_local = sample_vndf(v_local, alpha, rand_unit(seed, draw++),
                                rand_unit(seed, draw++), h, pdf);
                        wi = t_axis * l_local.x + b_axis * l_local.y + normal * l_local.z;
                        weight = 2.0 * specular_weight(l_local, v_local, h, f0, alpha, pdf);
                        chain_p = 2.0 * max(dot(normal, wi), 0.0) / max(pdf, COS_EPS);
                    } else if (covered && !immature) {
                        trace_ray = false;
                    } else {
                        float pdf;
                        wi = sample_cosine(normal, t_axis, b_axis, rand_unit(seed, draw++),
                                rand_unit(seed, draw++), pdf);
                        weight = 2.0 * (1.0 - metallic) * albedo;
                        chain_p = 2.0 * PI;
                    }

                    born = 1u;

                    if (depth == 0) {
                        // Revealed surface behind glass: its chain is the
                        // newborn primary chain, ridden by the later hops.
                        born = 0u;
                    }
                }

                if (!trace_ray) {
                    break;
                }
                vec3 wi_local = vec3(dot(wi, t_axis), dot(wi, b_axis), dot(wi, normal));
                next_p_bsdf = bsdf_mixture_pdf(wi_local, v_local, alpha, primary_lobe ? 0 : 1);
                throughput *= weight;

                // The standing chain rides this hop's weight and RR lottery;
                // the newborn chain opens at this hit's face.
                if (born == 1u && (chain_flags[0] & 1u) != 0u) {
                    chain_tp[0] *= weight;
                }

                float p = clamp(max(max(throughput.r, throughput.g), throughput.b), RR_FLOOR, 1.0);
                if (rand_unit(seed, draw++) >= p) {
                    break;
                }
                throughput /= p;

                if (born == 1u && (chain_flags[0] & 1u) != 0u) {
                    chain_tp[0] /= p;
                }

                if (hit_faced) {
                    chain_key[born] = uvec2(hit_key, hit_slot | (hit_face << 9));
                    chain_tp[born] = vec3(chain_p);
                    chain_flags[born] = 1u;
                }

                ro = hit_point + normal * BOUNCE_OFFSET;
                rd = wi;
                reset_payload();
                traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), ray_flags, 0xFFu, sbt_offset, 0u, 0u, ro, RAY_T_MIN, rd, RAY_T_MAX, 0);
            }

            if (glass_primary) {
                // Whole path to the specular channel at weight 1 (ADR 0013);
                // the diffuse channel reports no-data (0 radiance, nhd 0).
                specular = path;
            } else if (specular_lobe) {
                specular = path / lobe_p;
            } else {
                radiance += path / lobe_p;
            }
        } else if (crossed_miss) {
            // Crossed-only miss: the pane-tinted Procedural sky with the Sun
            // disk, plus emission collected on the glass voxels themselves.
            radiance = path + throughput * sky_radiance_with_disk(direction);
        } else {
            radiance = sky_radiance_with_disk(direction);
        }

        vec3 diffuse_de = (hit_t > 0.0)
            ? radiance / max(primary_albedo, vec3(ALBEDO_EPS)) : radiance;

        float viewz = (hit_t > 0.0)
            ? abs(-hit_t * dot(direction, camera.view_inverse[2].xyz)) : VIEWZ_SKY;

        vec3 mv = vec3(0.0);
        if (hit_t > 0.0) {
            vec4 world_prev = camera.view_prev * vec4(origin + direction * hit_t, 1.0);
            vec4 clip_prev = camera.proj_prev * world_prev;
            vec2 uv_prev = (clip_prev.xy / clip_prev.w) * 0.5 + 0.5;
            vec2 uv_cur = (vec2(gl_LaunchIDEXT.xy) + 0.5) / vec2(gl_LaunchSizeEXT.xy);
            float viewz_prev = abs(-world_prev.z);
            mv = vec3(uv_prev - uv_cur, viewz_prev - viewz);
        }

        vec4 normal_roughness = (hit_t > 0.0)
            ? pack_normal_and_roughness(primary_normal, primary_roughness) : vec4(0.0);

        // The lobe that continued past the primary hit carries its segment
        // length; the skipped lobe reports "no data" (NRD reconstructs it).
        float norm_hit_dist = (hit_t > 0.0 && bounce_t >= 0.0)
            ? get_norm_hit_dist(bounce_t, viewz, primary_roughness) : 0.0;
        float diff_nhd = (glass_primary || specular_lobe) ? 0.0 : norm_hit_dist;
        float spec_nhd = (glass_primary || specular_lobe) ? norm_hit_dist : 0.0;

        imageStore(vko_image2D_rgba16f(diff_radiance_image_id), pixel, pack_radiance_and_norm_hit_dist(diffuse_de, diff_nhd));
        imageStore(vko_image2D_rgba16f(spec_radiance_image_id), pixel, pack_radiance_and_norm_hit_dist(specular, spec_nhd));
        imageStore(vko_image2D_rgba8(normal_roughness_image_id), pixel, normal_roughness);
        imageStore(vko_image2D_r32f(viewz_image_id), pixel, vec4(viewz));
        imageStore(vko_image2D_rgba16f(mv_image_id), pixel, vec4(mv, 0.0));
        imageStore(vko_image2D_rgba8(albedo_metal_image_id), pixel, vec4(primary_albedo, primary_metallic));
        imageStore(vko_image2D_r8(disocclusion_mix_image_id), pixel, vec4(glass_primary ? 1.0 : 0.0));

        return;
    }

    if (mode == MODE_NORMAL) {
        imageStore(vko_image2D_rgba8(image_id), ivec2(gl_LaunchIDEXT.xy), vec4(payload.normal * 0.5 + 0.5, 1.0));
        return;
    }

    imageStore(vko_image2D_rgba8(image_id), ivec2(gl_LaunchIDEXT.xy), payload.color);
}
