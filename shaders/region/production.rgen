#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#ifdef ATLAS_RT_RAY_LATENCY
#extension GL_EXT_shader_realtime_clock : require
#endif

#include "../rt/common.glsl"
#include "header.glsl"
#include "common.glsl"
#include "../rt/raygen_common.glsl"
#include "../rt/heat_ramp.glsl"

layout(location = 0) rayPayloadEXT MainPassPayload payload;

// Render-mode selectors (match RenderMode in src/region/render.rs). Hull and
// the diagnostic modes are debug-build-only; release traces Voxel always.
const uint MODE_VOXEL = 0u;
const uint MODE_HULL = 1u;
const uint MODE_RAY_LATENCY = 2u;
const uint MODE_HULL_CROSSED = 3u;

// The latency heatmap's log2 span: the clock delta is mapped log2(delta) /
// this value onto the blue->red ramp, spanning 2^0 .. 2^20 ticks (~1 tick ..
// ~1 ms at a ~1 GHz clock). clockRealtime2x32EXT ticks at a device rate, so a
// different rate only shifts the whole map (a log scale is rate-agnostic in
// shape) — this is a tunable debug knob, not a physical duration.
const float LATENCY_LOG2_TICKS = 20.0;

// Production raygen for the Region path. The ray
// is built by the shared raygen_common.glsl (byte-identical to the capture
// raygen), traverses world-space f32 with Opaque over the camera near/far
// range, and writes the primary-visibility result to the
// swapchain storage image. Unlike the validation raygen it never
// dereferences t_image_id (the app pushes INVALID), so the frame is one
// imageStore per pixel.
//
// Deliberately NOT TerminateOnFirstHit: that flag terminates the trace at
// the first hit found in BVH traversal order, which is not guaranteed to be
// the closest. With stacked Regions along a ray the first found hit wins
// and a farther surface shows through a nearer one (the nuke-down
// validation world caught exactly that). Opaque alone keeps the
// any-hit-free fast path while preserving closest-hit semantics.
void main() {
    vec3 origin;
    vec3 direction;
    build_primary_ray(origin, direction);

    const uint ray_flags = gl_RayFlagsOpaqueEXT;

    payload.color = vec4(0.0);
    payload.t = -1.0;

    // The Render mode selects the hit group through the shader-binding-table
    // record offset: Hull = 1, hull-crossed = 2; Voxel and Ray latency trace
    // the DDA hit group (0) so the latency measures the real traversal. mode
    // is a per-frame push-constant flag, so a TAB toggle never rebuilds the
    // pipeline.
    uint sbt_offset = (mode == MODE_HULL) ? 1u : ((mode == MODE_HULL_CROSSED) ? 2u : 0u);

#ifdef ATLAS_RT_RAY_LATENCY
    if (mode == MODE_RAY_LATENCY) {
        // Ray latency: the wall-clock of the whole trace, warp-contaminated
        // (CONTEXT.md) — the only per-pixel instrument that includes the
        // hardware BVH traversal. Latency, not cost.
        uvec2 t0 = clockRealtime2x32EXT();
        traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), ray_flags, 0xFFu, sbt_offset, 0u, 0u, origin, RAY_T_MIN, direction, RAY_T_MAX, 0);
        uvec2 t1 = clockRealtime2x32EXT();
        // Low-32-bit delta (u32 wraparound): exact for sub-2^32-tick latencies.
        uint delta = t1.x - t0.x;
        // Log2 scale: per-ray latency spans orders of magnitude, so a linear
        // ramp crushes everything into the cold end. Map 2^0 .. 2^20 ticks
        // onto the ramp; a different clock rate shifts the map, not its shape.
        float t = clamp(log2(float(max(delta, 1u))) / LATENCY_LOG2_TICKS, 0.0, 1.0);
        payload.color = heat_color(t);
        imageStore(vko_image2D_rgba8(image_id), ivec2(gl_LaunchIDEXT.xy), payload.color);
        return;
    }
#endif

    traceRayEXT(vko_accelerationStructureEXT(acceleration_structure_id), ray_flags, 0xFFu, sbt_offset, 0u, 0u, origin, RAY_T_MIN, direction, RAY_T_MAX, 0);

    if (mode == MODE_VOXEL) {
        // Path-tracing output contract (ADR 0007): in Voxel mode the trace
        // pass writes the noisy radiance pair and the auxiliary guide
        // buffers instead of the swapchain — the composite node exposes them
        // (and, from ticket 08, the Denoise pass consumes them).
        //
        // Slice contents (real values land with tickets 03/05/08): the
        // diffuse radiance carries the palette color stub so the composite
        // still shows the world; specular is zero; the normal is the +Z
        // octahedral placeholder and roughness 1.0; viewZ is the real linear
        // view-space depth; the motion vector is zero (the prev-view-proj
        // plumbing lands with the Denoise pass); albedo is the real palette
        // color, metalness zero (the MATL chunk lands in ticket 03).
        ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
        float hit_t = payload.t;
        // Linear view-space Z of the primary hit: the ray's distance along
        // the view axis (view_inverse column 2 is the world-space backward
        // axis). Miss (the t == 0.0 sentinel) → 0.0.
        float viewz = (hit_t > 0.0) ? -hit_t * dot(direction, camera.view_inverse[2].xyz) : 0.0;
        vec3 albedo = payload.color.rgb;

        imageStore(vko_image2D_rgba16f(diff_radiance_image_id), pixel, vec4(albedo, 0.0));
        imageStore(vko_image2D_rgba16f(spec_radiance_image_id), pixel, vec4(0.0));
        imageStore(vko_image2D_rgba8(normal_roughness_image_id), pixel, vec4(0.5, 0.5, 0.0, 1.0));
        imageStore(vko_image2D_r32f(viewz_image_id), pixel, vec4(viewz));
        imageStore(vko_image2D_rgba16f(mv_image_id), pixel, vec4(0.0));
        imageStore(vko_image2D_rgba8(albedo_metal_image_id), pixel, vec4(albedo, 0.0));
        return;
    }

    // Debug modes (Hull, hull-crossed) paint the swapchain directly — the
    // composite node no-ops for them (shaders/region/composite.comp).
    imageStore(vko_image2D_rgba8(image_id), ivec2(gl_LaunchIDEXT.xy), payload.color);
}
